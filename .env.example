# Stesso progetto Supabase di Siderio Suite (vedi docs/architecture/ARCHITECTURE.md).
# Valori pubblici (anon key), sicuri da esporre lato client: l'accesso reale è
# regolato da RLS e dalle funzioni sales_ai.* definite in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://kvsrnxsaajsdmkikipjl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend Sales AI (api/sales-ai/*) ---
# Service role: MAI esposta al client, solo nelle env di Vercel. Bypassa RLS,
# usata dalle route API server-side per leggere/scrivere Suite e sales_ai.*.
SUPABASE_SERVICE_ROLE_KEY=

# Segreto condiviso con pg_cron/pg_net per autorizzare /api/sales-ai/process-next
# (stesso pattern del webhook POSTA_WEBHOOK_SECRET di Siderio-Suite-2).
SALES_AI_CRON_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Solo per esperimenti: se non impostata, la versione la decide il codice
# seguendo il prompt (oggi 1.2-backend-it). Lasciarla vuota e' la scelta giusta.
# SALES_AI_PROMPT_VERSION=

# true solo dopo aver verificato che email_commessa.commessa_id combacia col
# tipo di commesse.id (confermato bigint=bigint il 27/08/2026).
SALES_AI_ENABLE_EMAIL_COMMESSA_LOOKUP=true

SALES_AI_MAX_EMAILS=40
SALES_AI_MAX_EMAIL_BODY_CHARS=6000
SALES_AI_MAX_JOB_ATTEMPTS=3
SALES_AI_ALLOWED_ORIGIN=*
